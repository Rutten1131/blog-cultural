# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Claves SSH y secretos de VPS: NUNCA subir al repositorio ───
# `vps/antigravity_vps_key` es la clave PRIVADA del servidor.
# Si se filtra, cualquiera puede entrar al VPS.
vps/antigravity_vps_key
*_vps_key
id_rsa
id_ed25519
*.key
*-key

# Volcados y backups locales
*.rar
*.zip
*.bak
*.log
