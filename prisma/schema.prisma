// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Catálogo cerrado: Categorías ───────────────────────────
// Solo lectura para usuarios. Editable solo desde admin.
model Categoria {
  id     Int      @id @default(autoincrement())
  slug   String   @unique @db.VarChar(50)
  nombre String   @db.VarChar(100)

  eventos Evento[]

  @@map("categorias")
}

// ─── Catálogo cerrado: Zonas / Parroquias ───────────────────
// 6 urbanas + 13 rurales del cantón Loja.
// Solo lectura para usuarios. Editable solo desde admin.
model Zona {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(100)
  tipo   TipoZona

  eventos Evento[]

  @@map("zonas")
}

enum TipoZona {
  URBANA
  RURAL
}

// ─── Evento ─────────────────────────────────────────────────
model Evento {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(300)
  fecha        DateTime
  fechaFin     DateTime?     @map("fecha_fin")
  lugar        String        @db.VarChar(255)
  descripcion  String        @db.Text
  imagenUrl    String?       @db.VarChar(500)
  multimedia   Json?         // Array de URLs de imágenes para el carrusel
  videoUrl     String?       @db.VarChar(500) // Enlace a video (FB, IG, TikTok, YT)
  estado       EstadoEvento  @default(PENDIENTE)
  nombreGestor          String        @db.VarChar(200)
  confianzaClasificacion Float?
  createdAt             DateTime      @default(now())

  institucionRelacionada String?       @db.VarChar(150)
  categoriaId  Int?
  categoria    Categoria?    @relation(fields: [categoriaId], references: [id])

  zonaId       Int?
  zona         Zona?         @relation(fields: [zonaId], references: [id])

  @@index([estado])
  @@index([fecha])
  @@index([fechaFin])
  @@index([categoriaId])
  @@index([zonaId])
  @@map("eventos")
}

enum EstadoEvento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─── Buzón de sugerencias y recomendaciones ciudadanas ───────
model Recomendacion {
  id        Int      @id @default(autoincrement())
  mensaje   String   @db.Text
  contacto  String?  @db.VarChar(150)
  createdAt DateTime @default(now())

  @@map("recomendaciones")
}

// ─── Números de WhatsApp para notificaciones de admin ────────
// Gestionados desde el panel /admin. Se notifica a todos cuando
// un nuevo evento es enviado para revisión.
model NumeroNotificacion {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)   // Etiqueta descriptiva (Ej: "César - Admin")
  numero    String   @unique @db.VarChar(20) // Formato internacional sin + (Ej: 593987654321)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("numeros_notificacion")
}
