// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Catálogo cerrado: Categorías ───────────────────────────
// Solo lectura para usuarios. Editable solo desde admin.
model Categoria {
  id     Int      @id @default(autoincrement())
  slug   String   @unique @db.VarChar(50)
  nombre String   @db.VarChar(100)

  eventos Evento[]

  @@map("categorias")
}

// ─── Catálogo cerrado: Zonas / Parroquias ───────────────────
// 6 urbanas + 13 rurales del cantón Loja.
// Solo lectura para usuarios. Editable solo desde admin.
model Zona {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(100)
  tipo   TipoZona

  eventos Evento[]

  @@map("zonas")
}

enum TipoZona {
  URBANA
  RURAL
}

// ─── Evento ─────────────────────────────────────────────────
model Evento {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(300)
  fecha        DateTime
  fechaFin     DateTime?     @map("fecha_fin")
  lugar        String        @db.VarChar(255)
  descripcion  String        @db.Text
  imagenUrl    String?       @db.VarChar(500)
  multimedia   Json?         // Array de URLs de imágenes para el carrusel
  videoUrl     String?       @db.VarChar(500) // Enlace a video (FB, IG, TikTok, YT)
  mapaUrl      String?       @db.VarChar(500) // URL de Google Maps del lugar exacto del evento
  patrocinadores Json?       // Array de objetos [{ nombre: string, logoUrl: string }]
  estado       EstadoEvento  @default(PENDIENTE)
  nombreGestor          String        @db.VarChar(200)
  confianzaClasificacion Float?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  institucionRelacionada String?       @db.VarChar(150)
  editToken              String?       @unique @db.VarChar(100)   // Token único para link de edición sin login
  editTokenExpiresAt     DateTime?     @map("edit_token_expires_at") // Expira en la fecha del evento
  categoriaId  Int?
  categoria    Categoria?    @relation(fields: [categoriaId], references: [id])

  zonaId       Int?
  zona         Zona?         @relation(fields: [zonaId], references: [id])

  @@index([estado])
  @@index([fecha])
  @@index([fechaFin])
  @@index([categoriaId])
  @@index([zonaId])
  @@map("eventos")
}

enum EstadoEvento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─── Buzón de sugerencias y recomendaciones ciudadanas ───────
model Recomendacion {
  id        Int      @id @default(autoincrement())
  mensaje   String   @db.Text
  contacto  String?  @db.VarChar(150)
  createdAt DateTime @default(now())

  @@map("recomendaciones")
}

// ─── Números de WhatsApp para notificaciones de admin ────────
// Gestionados desde el panel /admin. Se notifica cuando
// un nuevo evento es enviado para revisión (al superadmin o a la institución).
model NumeroNotificacion {
  id            Int          @id @default(autoincrement())
  nombre        String       @db.VarChar(100)   // Etiqueta descriptiva (Ej: "César - Admin")
  numero        String       @db.VarChar(20)    // Formato internacional sin + (Ej: 593987654321)
  activo        Boolean      @default(true)
  institucionId Int?         @map("institucion_id")
  institucion   Institucion? @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([institucionId])
  @@index([numero])
  @@map("numeros_notificacion")
}

// ─── Instituciones asociadas / Cuentas de Acceso ───────────────
model Institucion {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(150)
  slug        String   @unique @db.VarChar(100)
  password    String   @db.VarChar(255)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())

  numerosNotificacion NumeroNotificacion[]

  @@map("instituciones")
}

// ─── Banners del Hero Principal ──────────────────────────────
model BannerHero {
  id            Int      @id @default(autoincrement())
  titulo        String   @db.VarChar(200)
  subtitulo     String?  @db.VarChar(255)
  link          String   @default("/eventos") @db.VarChar(500)
  botonTexto    String   @default("Ver evento") @db.VarChar(50)
  imagenDesktop String   @db.VarChar(500)
  imagenMobile  String?  @db.VarChar(500)
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([activo, orden])
  @@map("banners_hero")
}

// ─── Aliados Comerciales (Patrocinadores, Hoteles, Restaurantes) ─
model Aliado {
  id          Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(150)
  tipo        TipoAliado  @default(HOSPEDAJE)
  descripcion String      @db.Text
  ubicacion   String      @db.VarChar(255)
  ubicacionLat Float?
  ubicacionLng Float?
  mapaUrl     String?     @db.VarChar(500)
  rangoPrecio String?     @db.VarChar(100) // Ej: "$35 - $65 / noche"
  servicios   String?     @db.Text         // Ej: "Wifi fibra, Desayuno buffet, Parqueadero privado"
  cuartos     String?     @db.Text         // Ej: "Matrimoniales, Suites ejecutivas, Familiares"
  numeroCuartos Int?                       // Cantidad de habitaciones del establecimiento
  estrellas   Int?                         // Categoría / cantidad de estrellas (1-5)
  telefono    String?     @db.VarChar(50)  // WhatsApp internacional ej: 593991234567
  websiteUrl  String?     @db.VarChar(255)
  redesUrl    String?     @db.VarChar(255) // Instagram / Facebook / TikTok
  imagenUrl   String?     @db.VarChar(500)
  destacado   Boolean     @default(true)
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  habitaciones AliadoHabitacion[]

  @@index([tipo, activo])
  @@map("aliados")
}

/// Categorías / tipos de habitación de un aliado (precio, características y galería de imágenes)
model AliadoHabitacion {
  id              Int      @id @default(autoincrement())
  aliadoId        Int
  aliado          Aliado   @relation(fields: [aliadoId], references: [id], onDelete: Cascade)
  nombre          String   @db.VarChar(150) // Ej: "Suite Ejecutiva con balcón"
  precio          String?  @db.VarChar(100) // Ej: "$65 / noche"
  caracteristicas String?  @db.Text         // Qué incluye / qué tiene
  imagenes        String?  @db.Text         // JSON array de URLs para el carrusel
  orden           Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([aliadoId])
  @@map("aliado_habitaciones")
}

enum TipoAliado {
  HOSPEDAJE
  GASTRONOMIA
  CAFETERIA
  EXPERIENCIA
  TRANSPORTE
  CANTON_GAD
  CULTURA_ARTE
  COMERCIO
  OTRO
}

// ─── Atractivos Cantonales (Recomendación B2G Cruzada) ──────────
model AtractivoCantonal {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  canton      String   @db.VarChar(100) // Ej: "Saraguro", "Vilcabamba", "Catamayo", "Zamora"
  descripcion String   @db.Text
  distancia   String   @db.VarChar(100) // Ej: "A 1h 20min de Loja (65 km)"
  ruta        String   @db.VarChar(255) // Ej: "Vía Panamericana Norte hacia Saraguro"
  imagenUrl   String?  @db.VarChar(500)
  mapaUrl     String?  @db.VarChar(500)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([canton, activo])
  @@map("atractivos_cantonales")
}


// --- CRM Chatbot - Sesiones ---
model ChatSession {
  id               Int      @id @default(autoincrement())
  sessionId        String   @unique @db.VarChar(64)
  ubicacionLat     Float?
  ubicacionLng     Float?
  zonaDetectada    String?  @db.VarChar(150)
  direccionDetallada String? @db.VarChar(500)
  ciudad           String?  @db.VarChar(100)
  provincia        String?  @db.VarChar(100)
  pais             String?  @db.VarChar(50)
  userAgent        String?  @db.VarChar(500)
  ipAddress        String?  @db.VarChar(60)
  totalMensajes    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mensajes         ChatMessage[]
  @@index([createdAt])
  @@index([zonaDetectada])
  @@map("chat_sessions")
}

model ChatMessage {
  id               Int         @id @default(autoincrement())
  sessionId        String      @db.VarChar(64)
  sesion           ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sender           String      @db.VarChar(10)
  contenido        String      @db.Text
  aliadosIds       Json?
  eventosIds       Json?
  atractivosIds    Json?
  createdAt        DateTime    @default(now())
  @@index([sessionId])
  @@map("chat_messages")
}

// ─── Posts de Moderación Social (WhatsApp Worker) ───────────
// Posts extraídos de redes sociales/WhatsApp para moderación.
// No se publican automáticamente; requieren revisión humana.
model PostSocial {
  id             Int            @id @default(autoincrement())
  origen         String         @db.VarChar(50)   // WHATSAPP_GRUPO, MANUAL, etc.
  urlOriginal    String?        @db.VarChar(500)
  textoOriginal  String?        @db.Text
  titulo         String?        @db.VarChar(255)
  descripcion    String?        @db.Text
  imagenUrl      String?        @db.VarChar(500)
  // Todas las fotos del carrusel (la primera es la portada de imagenUrl).
  // Se guardan ya re-alojadas en Bunny: las URLs de Instagram/Facebook caducan.
  multimedia     Json?
  fechaPublicacion DateTime?
  lugar          String?        @db.VarChar(255)
  estado         EstadoPost     @default(PENDIENTE)
  grupoId        String?        @db.VarChar(100)
  moderadoPor    String?        @db.VarChar(100)
  moderadoAt     DateTime?
  moderationComentario String?   @db.Text
  confianzaIA    Float?
  fechaDeteccion DateTime        @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([estado])
  @@index([fechaDeteccion])
  @@index([origen])
  @@map("posts_social")
}

enum EstadoPost {
  PENDIENTE
  APROBADO
  RECHAZADO
}
