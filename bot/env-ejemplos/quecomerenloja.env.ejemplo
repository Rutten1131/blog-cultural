# ================================================================
# .env de ejemplo para: QUE COMER EN LOJA (quecomerenloja.com)
# ================================================================
# Copia este archivo como .env en la raiz de ese proyecto y
# llena los valores reales. El .env.local tiene prioridad en Next.js.
#
# IMPORTANTE: .env nunca se sube a git (.gitignore ya lo excluye).
# ================================================================

# ── BASE DE DATOS DEL PROYECTO (restaurantes, menus, cafeterias) ──
# Esta DB es EXCLUSIVA de quecomerenloja — NO se comparte
DATABASE_URL="mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE_DE_DATOS"

# ── DB CENTRAL DEL BOT (COMPARTIDA con Agenda Cultural y Agenda Turistica) ──
# Esta es la misma en los 3 proyectos — es donde se guarda el CRM del chatbot
CHATBOT_DB_URL="mysql://Botempresas-353039368f96:nb3%25.yCmga2%7C@mysql.us.stackcp.com:44521/Botempresas-353039368f96"

# ── IDENTIFICADOR DEL SITIO (MUY IMPORTANTE — diferencia los proyectos en el CRM) ──
CHATBOT_SITE_ID="quecomerenloja"

# ── CLAVES DE IA (puedes usar las mismas que Agenda Cultural) ──
DEEPSEEK_API_KEY="sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GROQ_API_KEY="gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── URL PUBLICA DEL SITIO ──
NEXT_PUBLIC_APP_URL="https://www.quecomerenloja.com"

# ── CONTRASENA DEL ADMIN (cambia por una segura) ──
ADMIN_PASSWORD="admin123_quecomer"

