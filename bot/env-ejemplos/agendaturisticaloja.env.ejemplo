# ================================================================
# .env de ejemplo para: AGENDA TURISTICA LOJA (agendaturisticaloja.com)
# ================================================================
# Copia este archivo como .env en la raiz de ese proyecto y
# llena los valores reales.
# ================================================================

# ── BASE DE DATOS DEL PROYECTO (atractivos, cantones, rutas, hospedaje) ──
# Esta DB es EXCLUSIVA de agendaturisticaloja — NO se comparte
DATABASE_URL="mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE_DE_DATOS"

# ── DB CENTRAL DEL BOT (COMPARTIDA con Agenda Cultural y Que Comer en Loja) ──
# Esta es la misma en los 3 proyectos — CRM centralizado del chatbot
CHATBOT_DB_URL="mysql://Botempresas-353039368f96:nb3%25.yCmga2%7C@mysql.us.stackcp.com:44521/Botempresas-353039368f96"

# ── IDENTIFICADOR DEL SITIO (CRITICO — identifica este proyecto en el CRM) ──
CHATBOT_SITE_ID="agendaturisticaloja"

# ── CLAVES DE IA (puedes usar las mismas que Agenda Cultural) ──
DEEPSEEK_API_KEY="sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GROQ_API_KEY="gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── URL PUBLICA DEL SITIO ──
NEXT_PUBLIC_APP_URL="https://www.agendaturisticaloja.com"

# ── CONTRASENA DEL ADMIN (cambia por una segura) ──
ADMIN_PASSWORD="admin123_turistica"

